{
  "name": "zero-tui-ts",
  "private": true,
  "version": "0.1.4",
  "type": "module",
  "description": "TypeScript terminal interface for the native Zero memory forensics engine",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/main.js",
    "test": "npm run build && node --test 'dist/test/*.test.js'"
  },
  "dependencies": {
    "ink": "^8.0.0",
    "react": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "typescript": "^5.9.0"
  }
}
